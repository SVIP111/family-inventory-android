<?xml version="1.0" encoding="utf-8"?>
<!-- 家庭内网部署通常是 http://NAS:8080，允许明文 HTTP；外网建议配置 HTTPS。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
